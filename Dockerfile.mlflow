# Dockerfile.mlflow
FROM python:3.10-slim

RUN pip install mlflow psycopg2-binary boto3

# MLflow 서버 실행 (포트 5000)
# --host 0.0.0.0 설정이 있어야 외부(팀원들) 접속이 가능합니다.
EXPOSE 5000

CMD mlflow server \
    --host 0.0.0.0 \
    --port 5000 \
    --backend-store-uri $DATABASE_URL \
    --default-artifact-root $ARTIFACT_ROOT